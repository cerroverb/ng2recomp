From 850ecb363bdd5f9348c3bbc2eea7e0c9c834899d Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sat, 21 Nov 2026 17:06:15 +0000
Subject: [PATCH 29/35] Kernel: contended critical sections reported to a
 profiler (SetLockObserver: waiter, holder and lock)

---
 include/rex/hook.h                         |  7 +++++
 src/kernel/xboxkrnl/xboxkrnl_rtl.cpp       | 34 ++++++++++++++++++++++
 src/kernel/xboxkrnl/xboxkrnl_threading.cpp |  4 +++
 3 files changed, 45 insertions(+)

diff --git a/include/rex/hook.h b/include/rex/hook.h
index ff9a49d0..046657dc 100644
--- a/include/rex/hook.h
+++ b/include/rex/hook.h
@@ -33,6 +33,13 @@ namespace rex {
 using WaitObserver = void (*)(const char* name, uint32_t lr, uint32_t r3, int64_t ns);
 extern std::atomic<WaitObserver> g_wait_observer;
 void SetWaitObserver(WaitObserver observer);
+// Called after a critical section's full wait while set (the section owned
+// by then): the thread that held it as the wait began (its handle, 0 if
+// unknown) and its last call there (ctx.lr), the section's guest address and
+// the wait's time.
+using LockObserver = void (*)(uint32_t holder_handle, uint32_t holder_lr, uint32_t cs, int64_t ns);
+extern std::atomic<LockObserver> g_lock_observer;
+void SetLockObserver(LockObserver observer);
 }  // namespace rex
 
 //=============================================================================
diff --git a/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp b/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
index 9d363d92..ae5f6f2e 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
@@ -13,6 +13,7 @@
 #pragma GCC diagnostic ignored "-Wunused-parameter"
 
 #include <algorithm>
+#include <chrono>
 #include <string>
 
 #include <rex/chrono/chrono_steady_cast.h>
@@ -398,8 +399,41 @@ void RtlEnterCriticalSection_entry(ppc_ptr_t<X_RTL_CRITICAL_SECTION> cs) {
   }
 
   if (rex::thread::atomic_inc(&cs->lock_count) != 0) {
+    // (a lock observer: who held it, and where; reported once this thread
+    // owns the section, so the report's own time isn't spent holding it
+    // unowned)
+    auto observer = rex::g_lock_observer.load(std::memory_order_relaxed);
+    uint32_t holder_handle = 0, holder_lr = 0;
+    std::chrono::steady_clock::time_point start;
+    if (observer) {
+      // The owner's thread object by the handle its header holds, never made
+      // anew (a stale owner's memory may hold another object, or none)
+      if (uint32_t owner = cs->owning_thread) {
+        auto header = REX_KERNEL_MEMORY()->TranslateVirtual<X_DISPATCH_HEADER*>(owner);
+        if (header->type == 6 && header->wait_list_flink == kXObjSignature) {
+          if (auto holder = REX_KERNEL_OBJECTS()->LookupObject<XThread>(header->wait_list_blink)) {
+            holder_handle = holder->handle();
+            if (auto* state = holder->thread_state()) {
+              holder_lr = uint32_t(state->context()->lr);
+            }
+          }
+        }
+      }
+      start = std::chrono::steady_clock::now();
+    }
     // Create a full waiter.
     xeKeWaitForSingleObject(reinterpret_cast<void*>(cs.host_address()), 8, 0, 0, nullptr);
+    int64_t waited = observer ? std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                    std::chrono::steady_clock::now() - start)
+                                    .count()
+                              : 0;
+    assert_true(cs->owning_thread == 0);
+    cs->owning_thread = cur_thread;
+    cs->recursion_count = 1;
+    if (observer) {
+      observer(holder_handle, holder_lr, cs.guest_address(), waited);
+    }
+    return;
   }
 
   assert_true(cs->owning_thread == 0);
diff --git a/src/kernel/xboxkrnl/xboxkrnl_threading.cpp b/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
index 44365258..ab536f60 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
@@ -380,6 +380,10 @@ std::atomic<WaitObserver> g_wait_observer{nullptr};
 void SetWaitObserver(WaitObserver observer) {
   g_wait_observer.store(observer);
 }
+std::atomic<LockObserver> g_lock_observer{nullptr};
+void SetLockObserver(LockObserver observer) {
+  g_lock_observer.store(observer);
+}
 }  // namespace rex
 
 namespace rex::kernel::xboxkrnl {
-- 
