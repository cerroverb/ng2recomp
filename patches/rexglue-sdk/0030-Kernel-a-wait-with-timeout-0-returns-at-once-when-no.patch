From c6169f048162862390ee665ba4d4d1b09963ef9e Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sat, 21 Nov 2026 17:06:15 +0000
Subject: [PATCH 30/35] Kernel: a wait with timeout 0 returns at once when not
 signalled, yields only 1 in 64; alertable waits try the object before the
 deadline

---
 src/core/threading_posix.cpp | 34 +++++++++++++++++++++++-----------
 src/system/xobject.cpp       | 26 ++++++++++++++++++++++----
 2 files changed, 45 insertions(+), 15 deletions(-)

diff --git a/src/core/threading_posix.cpp b/src/core/threading_posix.cpp
index f5b8f31f..ac2cd899 100644
--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -346,6 +346,12 @@ class PosixConditionBase {
       if (timeout == std::chrono::milliseconds::max()) {
         cond_.wait(lock, predicate);
         executed = true;  // Did not time out;
+      } else if (timeout.count() == 0) {
+        // A poll: not signalled, so timed out, without a timed wait. (One
+        // whose time is already up still sleeps until the system timer's
+        // next tick where its timers are coarse: about 1 ms a poll on a PS5
+        // with Linux, #127.)
+        executed = false;
       } else {
         executed = cond_.wait_for(lock, timeout, predicate);
       }
@@ -1269,10 +1275,8 @@ WaitResult Wait(WaitHandle* wait_handle, bool is_alertable, std::chrono::millise
     if (DispatchCurrentThreadUserCallback(condition, ticket)) {
       return WaitResult::kUserCallback;
     }
-    if (HasAlertableTimeoutElapsed(deadline)) {
-      condition.Dequeue(ticket);
-      return WaitResult::kTimeout;
-    }
+    // Tried before the deadline is checked: a wait whose time is already up
+    // (timeout 0, a poll) still takes the object when it is signalled.
     auto result = condition.WaitQueued(ticket, ComputeAlertableWaitTimeout(deadline), false);
     if (result != WaitResult::kTimeout) {
       if (result != WaitResult::kSuccess) {
@@ -1280,6 +1284,10 @@ WaitResult Wait(WaitHandle* wait_handle, bool is_alertable, std::chrono::millise
       }
       return result;
     }
+    if (HasAlertableTimeoutElapsed(deadline)) {
+      condition.Dequeue(ticket);
+      return WaitResult::kTimeout;
+    }
   }
 }
 
@@ -1311,10 +1319,8 @@ WaitResult SignalAndWait(WaitHandle* wait_handle_to_signal, WaitHandle* wait_han
     if (DispatchCurrentThreadUserCallback(wait_on, ticket)) {
       return WaitResult::kUserCallback;
     }
-    if (HasAlertableTimeoutElapsed(deadline)) {
-      wait_on.Dequeue(ticket);
-      return WaitResult::kTimeout;
-    }
+    // Tried before the deadline is checked: a wait whose time is already up
+    // (timeout 0, a poll) still takes the object when it is signalled.
     result = wait_on.WaitQueued(ticket, ComputeAlertableWaitTimeout(deadline), false);
     if (result != WaitResult::kTimeout) {
       if (result != WaitResult::kSuccess) {
@@ -1322,6 +1328,10 @@ WaitResult SignalAndWait(WaitHandle* wait_handle_to_signal, WaitHandle* wait_han
       }
       return result;
     }
+    if (HasAlertableTimeoutElapsed(deadline)) {
+      wait_on.Dequeue(ticket);
+      return WaitResult::kTimeout;
+    }
   }
 }
 
@@ -1347,14 +1357,16 @@ std::pair<WaitResult, size_t> WaitMultiple(WaitHandle* wait_handles[], size_t wa
     if (DispatchCurrentThreadUserCallback()) {
       return std::make_pair(WaitResult::kUserCallback, 0);
     }
-    if (HasAlertableTimeoutElapsed(deadline)) {
-      return std::make_pair(WaitResult::kTimeout, 0);
-    }
+    // Tried before the deadline is checked: a wait whose time is already up
+    // (timeout 0, a poll) still takes the object when it is signalled.
     auto result = PosixConditionBase::WaitMultiple(std::vector<PosixConditionBase*>(conditions),
                                                    wait_all, ComputeAlertableWaitTimeout(deadline));
     if (result.first != WaitResult::kTimeout) {
       return result;
     }
+    if (HasAlertableTimeoutElapsed(deadline)) {
+      return std::make_pair(WaitResult::kTimeout, 0);
+    }
   }
 }
 
diff --git a/src/system/xobject.cpp b/src/system/xobject.cpp
index d358f399..09a2ff3b 100644
--- a/src/system/xobject.cpp
+++ b/src/system/xobject.cpp
@@ -200,6 +200,24 @@ uint32_t XObject::TimeoutTicksToMs(int64_t timeout_ticks) {
   }
 }
 
+// After a wait timed out. A poll (no timeout: is it signalled yet?) yields
+// only every 64th time on a thread: a game that polls a list of events
+// under a lock paid a yield each, and on a busy Linux system a yield gives
+// the core away for a scheduler tick (about 1 ms a poll on a PS5 with Linux,
+// the main thread waiting 600 ms a second for that lock, #127). The
+// occasional yield still lets a thread polling in a loop make way.
+// (a poll by the guest's own value: a timeout under a millisecond is 0 ms here
+// too, and keeps its yield)
+static void YieldAfterTimeout(const uint64_t* opt_timeout) {
+  if (opt_timeout && *opt_timeout == 0) {
+    thread_local uint32_t polls = 0;
+    if (++polls % 64 != 0) {
+      return;
+    }
+  }
+  rex::thread::MaybeYield();
+}
+
 X_STATUS XObject::Wait(uint32_t wait_reason, uint32_t processor_mode, uint32_t alertable,
                        uint64_t* opt_timeout) {
   auto wait_handle = GetWaitHandle();
@@ -223,7 +241,7 @@ X_STATUS XObject::Wait(uint32_t wait_reason, uint32_t processor_mode, uint32_t a
       // Or X_STATUS_ALERTED?
       return X_STATUS_USER_APC;
     case rex::thread::WaitResult::kTimeout:
-      rex::thread::MaybeYield();
+      YieldAfterTimeout(opt_timeout);
       return X_STATUS_TIMEOUT;
     default:
     case rex::thread::WaitResult::kAbandoned:
@@ -250,7 +268,7 @@ X_STATUS XObject::SignalAndWait(XObject* signal_object, XObject* wait_object, ui
       // Or X_STATUS_ALERTED?
       return X_STATUS_USER_APC;
     case rex::thread::WaitResult::kTimeout:
-      rex::thread::MaybeYield();
+      YieldAfterTimeout(opt_timeout);
       return X_STATUS_TIMEOUT;
     default:
     case rex::thread::WaitResult::kAbandoned:
@@ -286,7 +304,7 @@ X_STATUS XObject::WaitMultiple(uint32_t count, XObject** objects, uint32_t wait_
         // Or X_STATUS_ALERTED?
         return X_STATUS_USER_APC;
       case rex::thread::WaitResult::kTimeout:
-        rex::thread::MaybeYield();
+        YieldAfterTimeout(opt_timeout);
         return X_STATUS_TIMEOUT;
       default:
       case rex::thread::WaitResult::kAbandoned:
@@ -309,7 +327,7 @@ X_STATUS XObject::WaitMultiple(uint32_t count, XObject** objects, uint32_t wait_
         // Or X_STATUS_ALERTED?
         return X_STATUS_USER_APC;
       case rex::thread::WaitResult::kTimeout:
-        rex::thread::MaybeYield();
+        YieldAfterTimeout(opt_timeout);
         return X_STATUS_TIMEOUT;
       default:
       case rex::thread::WaitResult::kAbandoned:
