index 7bd264bc..7bda2add 100644
--- a/tests/unit/CMakeLists.txt
+++ b/tests/unit/CMakeLists.txt
@@ -7,6 +7,7 @@ add_executable(unit_tests
     core/cvar_test.cpp
     core/fiber_test.cpp
