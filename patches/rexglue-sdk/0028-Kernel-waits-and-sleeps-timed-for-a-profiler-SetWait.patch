From 5eaeff72eadb8ecef5a992cb9eb78abf5f886517 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Fri, 20 Nov 2026 14:43:15 +0000
Subject: [PATCH] Kernel: waits and sleeps timed for a profiler
 (SetWaitObserver: the call, the guest caller and its time)

---
 include/rex/hook.h                         | 30 ++++++++++++++++++++++
 src/kernel/xboxkrnl/xboxkrnl_rtl.cpp       |  2 +-
 src/kernel/xboxkrnl/xboxkrnl_threading.cpp | 25 +++++++++++++-----
 3 files changed, 49 insertions(+), 8 deletions(-)

diff --git a/include/rex/hook.h b/include/rex/hook.h
index 4ce4f9b..ff9a49d 100644
--- a/include/rex/hook.h
+++ b/include/rex/hook.h
@@ -11,6 +11,8 @@
 
 #pragma once
 
+#include <atomic>
+#include <chrono>
 #include <cstring>
 #include <tuple>
 #include <type_traits>
@@ -24,6 +26,15 @@
 #include <rex/system/thread_state.h>
 #include <rex/types.h>
 
+namespace rex {
+// Called after each timed kernel export (waits and sleeps) while set. The
+// variable lives in the runtime (a DLL on Windows): the game sets it through
+// SetWaitObserver.
+using WaitObserver = void (*)(const char* name, uint32_t lr, uint32_t r3, int64_t ns);
+extern std::atomic<WaitObserver> g_wait_observer;
+void SetWaitObserver(WaitObserver observer);
+}  // namespace rex
+
 //=============================================================================
 // Hook Macros
 //=============================================================================
@@ -73,6 +84,25 @@
   REX_HOOK(name, function)         \
   static rex::ppc::detail::PPCFuncRegistrar _ppc_reg_##name(#name, &name);
 
+// Timed export: when a wait observer is set (profiling), reports how long the
+// call took, the guest caller (lr) and its first argument (r3).
+#define REX_EXPORT_TIMED(name, function)                                             \
+  extern "C" REX_FUNC(name) {                                                        \
+    auto ___observer = rex::g_wait_observer.load(std::memory_order_relaxed);         \
+    if (!___observer) {                                                              \
+      rex::ppc::HostToGuestFunction<function>(ctx, base);                            \
+      return;                                                                        \
+    }                                                                                \
+    uint32_t ___lr = static_cast<uint32_t>(ctx.lr), ___r3 = ctx.r3.u32;              \
+    auto ___start = std::chrono::steady_clock::now();                                \
+    rex::ppc::HostToGuestFunction<function>(ctx, base);                              \
+    ___observer(#name, ___lr, ___r3,                                                 \
+                std::chrono::duration_cast<std::chrono::nanoseconds>(                \
+                    std::chrono::steady_clock::now() - ___start)                     \
+                    .count());                                                       \
+  }                                                                                  \
+  static rex::ppc::detail::PPCFuncRegistrar _ppc_reg_##name(#name, &name);
+
 #define REX_EXPORT_STUB(name) \
   REX_STUB(name)              \
   static rex::ppc::detail::PPCFuncRegistrar _ppc_reg_##name(#name, &name);
diff --git a/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp b/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
index 8b862fc..9d363d9 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
@@ -618,7 +618,7 @@ REX_EXPORT(__imp__RtlInitializeCriticalSection,
            rex::kernel::xboxkrnl::RtlInitializeCriticalSection_entry)
 REX_EXPORT(__imp__RtlInitializeCriticalSectionAndSpinCount,
            rex::kernel::xboxkrnl::RtlInitializeCriticalSectionAndSpinCount_entry)
-REX_EXPORT(__imp__RtlEnterCriticalSection, rex::kernel::xboxkrnl::RtlEnterCriticalSection_entry)
+REX_EXPORT_TIMED(__imp__RtlEnterCriticalSection, rex::kernel::xboxkrnl::RtlEnterCriticalSection_entry)
 REX_EXPORT(__imp__RtlTryEnterCriticalSection,
            rex::kernel::xboxkrnl::RtlTryEnterCriticalSection_entry)
 REX_EXPORT(__imp__RtlLeaveCriticalSection, rex::kernel::xboxkrnl::RtlLeaveCriticalSection_entry)
diff --git a/src/kernel/xboxkrnl/xboxkrnl_threading.cpp b/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
index 57fd161..4436525 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
@@ -373,6 +373,17 @@ u32 KeQueryPerformanceFrequency_entry() {
   return static_cast<uint32_t>(result);
 }
 
+}  // namespace rex::kernel::xboxkrnl
+
+namespace rex {
+std::atomic<WaitObserver> g_wait_observer{nullptr};
+void SetWaitObserver(WaitObserver observer) {
+  g_wait_observer.store(observer);
+}
+}  // namespace rex
+
+namespace rex::kernel::xboxkrnl {
+
 u32 KeDelayExecutionThread_entry(u32 processor_mode, u32 alertable, mapped_u64 interval_ptr) {
   XThread* thread = XThread::GetCurrentThread();
 
@@ -1447,8 +1458,8 @@ REX_EXPORT(__imp__KeGetCurrentProcessType, rex::kernel::xboxkrnl::KeGetCurrentPr
 REX_EXPORT(__imp__KeSetCurrentProcessType, rex::kernel::xboxkrnl::KeSetCurrentProcessType_entry)
 REX_EXPORT(__imp__KeQueryPerformanceFrequency,
            rex::kernel::xboxkrnl::KeQueryPerformanceFrequency_entry)
-REX_EXPORT(__imp__KeDelayExecutionThread, rex::kernel::xboxkrnl::KeDelayExecutionThread_entry)
-REX_EXPORT(__imp__NtYieldExecution, rex::kernel::xboxkrnl::NtYieldExecution_entry)
+REX_EXPORT_TIMED(__imp__KeDelayExecutionThread, rex::kernel::xboxkrnl::KeDelayExecutionThread_entry)
+REX_EXPORT_TIMED(__imp__NtYieldExecution, rex::kernel::xboxkrnl::NtYieldExecution_entry)
 REX_EXPORT(__imp__KeQuerySystemTime, rex::kernel::xboxkrnl::KeQuerySystemTime_entry)
 REX_EXPORT(__imp__KeTlsAlloc, rex::kernel::xboxkrnl::KeTlsAlloc_entry)
 REX_EXPORT(__imp__KeTlsFree, rex::kernel::xboxkrnl::KeTlsFree_entry)
@@ -1472,12 +1483,12 @@ REX_EXPORT(__imp__NtCreateTimer, rex::kernel::xboxkrnl::NtCreateTimer_entry)
 REX_EXPORT(__imp__NtSetTimerEx, rex::kernel::xboxkrnl::NtSetTimerEx_entry)
 REX_EXPORT(__imp__NtCancelTimer, rex::kernel::xboxkrnl::NtCancelTimer_entry)
 REX_EXPORT(__imp__KeInitializeTimerEx, rex::kernel::xboxkrnl::KeInitializeTimerEx_entry)
-REX_EXPORT(__imp__KeWaitForSingleObject, rex::kernel::xboxkrnl::KeWaitForSingleObject_entry)
-REX_EXPORT(__imp__NtWaitForSingleObjectEx, rex::kernel::xboxkrnl::NtWaitForSingleObjectEx_entry)
-REX_EXPORT(__imp__KeWaitForMultipleObjects, rex::kernel::xboxkrnl::KeWaitForMultipleObjects_entry)
-REX_EXPORT(__imp__NtWaitForMultipleObjectsEx,
+REX_EXPORT_TIMED(__imp__KeWaitForSingleObject, rex::kernel::xboxkrnl::KeWaitForSingleObject_entry)
+REX_EXPORT_TIMED(__imp__NtWaitForSingleObjectEx, rex::kernel::xboxkrnl::NtWaitForSingleObjectEx_entry)
+REX_EXPORT_TIMED(__imp__KeWaitForMultipleObjects, rex::kernel::xboxkrnl::KeWaitForMultipleObjects_entry)
+REX_EXPORT_TIMED(__imp__NtWaitForMultipleObjectsEx,
            rex::kernel::xboxkrnl::NtWaitForMultipleObjectsEx_entry)
-REX_EXPORT(__imp__NtSignalAndWaitForSingleObjectEx,
+REX_EXPORT_TIMED(__imp__NtSignalAndWaitForSingleObjectEx,
            rex::kernel::xboxkrnl::NtSignalAndWaitForSingleObjectEx_entry)
 REX_EXPORT(__imp__KfAcquireSpinLock, rex::kernel::xboxkrnl::KfAcquireSpinLock_entry)
 REX_EXPORT(__imp__KfReleaseSpinLock, rex::kernel::xboxkrnl::KfReleaseSpinLock_entry)
