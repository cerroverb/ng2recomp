From c4a4ce5bd5a965d76c13157ac94abf791b7311b2 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sat, 21 Nov 2026 17:06:15 +0000
Subject: [PATCH 32/35] Codegen: upstream fixes: stwcx/stdcx as atomic
 compare-exchange, no fences on mfmsr/mtmsrd, srad/sraw carry for big shifts,
 fctid/fctidz saturate at 2^63, vcmpbfp NaN, vpkd3d128 and vpkuwus/vpkuhus
 read a copy of the source

---
 src/codegen/builders/floating_point.cpp |  4 +-
 src/codegen/builders/helpers.h          |  5 +-
 src/codegen/builders/logical.cpp        |  6 +++
 src/codegen/builders/memory.cpp         |  4 +-
 src/codegen/builders/system.cpp         |  4 --
 src/codegen/builders/vector.cpp         | 68 +++++++++++++++----------
 tests/ppc/asm/instr_vpkuhus.s           | 18 +++++++
 tests/ppc/asm/instr_vpkuwus.s           | 21 ++++++++
 8 files changed, 94 insertions(+), 36 deletions(-)

diff --git a/src/codegen/builders/floating_point.cpp b/src/codegen/builders/floating_point.cpp
index 17022416..67d17e24 100644
--- a/src/codegen/builders/floating_point.cpp
+++ b/src/codegen/builders/floating_point.cpp
@@ -60,7 +60,7 @@ bool build_fctid(BuilderContext& ctx) {
   ctx.emit_set_flush_mode(false);
   ctx.println(
       "\t{0}.s64 = std::isnan({1}.f64) ? int64_t(0x8000000000000000ULL) : "
-      "({1}.f64 > double(LLONG_MAX)) ? LLONG_MAX : "
+      "({1}.f64 >= 0x1p63) ? LLONG_MAX : "
       "simde_mm_cvtsd_si64(simde_mm_load_sd(&{1}.f64));",
       ctx.f(ctx.insn.operands[0]), ctx.f(ctx.insn.operands[1]));
   return true;
@@ -70,7 +70,7 @@ bool build_fctidz(BuilderContext& ctx) {
   ctx.emit_set_flush_mode(false);
   ctx.println(
       "\t{0}.s64 = std::isnan({1}.f64) ? int64_t(0x8000000000000000ULL) : "
-      "({1}.f64 > double(LLONG_MAX)) ? LLONG_MAX : "
+      "({1}.f64 >= 0x1p63) ? LLONG_MAX : "
       "simde_mm_cvttsd_si64(simde_mm_load_sd(&{1}.f64));",
       ctx.f(ctx.insn.operands[0]), ctx.f(ctx.insn.operands[1]));
   return true;
diff --git a/src/codegen/builders/helpers.h b/src/codegen/builders/helpers.h
index dbc8d515..f4dbc5b7 100644
--- a/src/codegen/builders/helpers.h
+++ b/src/codegen/builders/helpers.h
@@ -305,8 +305,9 @@ inline void emitAtomicStoreConditional(BuilderContext& ctx, const char* ptr_type
   ctx.println("\t{}.lt = 0;", ctx.cr(0));
   ctx.println("\t{}.gt = 0;", ctx.cr(0));
   ctx.println(
-      "\t{}.eq = __sync_bool_compare_and_swap(reinterpret_cast<{}*>(REX_RAW_ADDR({})), "
-      "{}.{}, {}({}.{}));",
+      "\t{}.eq = reinterpret_cast<std::atomic<{}>*>(REX_RAW_ADDR({}))"
+      "->compare_exchange_strong({}.{}, {}({}.{}), "
+      "std::memory_order_acq_rel, std::memory_order_acquire);",
       ctx.cr(0), ptr_type, ctx.ea(), ctx.reserved(), field, bswap_func, ctx.r(ctx.insn.operands[0]),
       field);
   ctx.println("\t{}.so = {}.so;", ctx.cr(0), ctx.xer());
diff --git a/src/codegen/builders/logical.cpp b/src/codegen/builders/logical.cpp
index a58f51d0..8ce4a3b7 100644
--- a/src/codegen/builders/logical.cpp
+++ b/src/codegen/builders/logical.cpp
@@ -351,6 +351,9 @@ bool build_srad(BuilderContext& ctx) {
   ctx.println("\t{}.ca = ({}.s64 < 0) & ((({}.s64 >> {}.u64) << {}.u64) != {}.s64);", ctx.xer(),
               ctx.r(ctx.insn.operands[1]), ctx.r(ctx.insn.operands[1]), ctx.temp(), ctx.temp(),
               ctx.r(ctx.insn.operands[1]));
+  // A shift of 64 or more shifts every bit out: CA is the sign
+  ctx.println("\tif ({}.u8 & 0x40) {}.ca = {}.s64 < 0;", ctx.r(ctx.insn.operands[2]), ctx.xer(),
+              ctx.r(ctx.insn.operands[1]));
   ctx.println("\t{}.s64 = {}.s64 >> {}.u64;", ctx.r(ctx.insn.operands[0]),
               ctx.r(ctx.insn.operands[1]), ctx.temp());
   emitRecordFormCompare(ctx);
@@ -378,6 +381,9 @@ bool build_sraw(BuilderContext& ctx) {
   ctx.println("\t{}.ca = ({}.s32 < 0) & ((({}.s32 >> {}.u32) << {}.u32) != {}.s32);", ctx.xer(),
               ctx.r(ctx.insn.operands[1]), ctx.r(ctx.insn.operands[1]), ctx.temp(), ctx.temp(),
               ctx.r(ctx.insn.operands[1]));
+  // A shift of 32 or more shifts every bit out: CA is the sign
+  ctx.println("\tif ({}.u8 & 0x20) {}.ca = {}.s32 < 0;", ctx.r(ctx.insn.operands[2]), ctx.xer(),
+              ctx.r(ctx.insn.operands[1]));
   ctx.println("\t{}.s64 = {}.s32 >> {}.u32;", ctx.r(ctx.insn.operands[0]),
               ctx.r(ctx.insn.operands[1]), ctx.temp());
   emitRecordFormCompare(ctx);
diff --git a/src/codegen/builders/memory.cpp b/src/codegen/builders/memory.cpp
