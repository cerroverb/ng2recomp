From 0d26d381ea5057e0eaae79925f8a8d8a78ccc565 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Wed, 11 Nov 2026 20:36:31 +0000
Subject: [PATCH] Threads: a title's priority boosts of 15/16 (audio) map to
 the highest priority

KeSetBasePriorityThread increments run -16..16; the old thresholds (over
0x11 / 0x22) left the real-time requests a title makes for its audio
threads at normal priority, so on a busy CPU they got no more time than the
threads they feed and the sound ran dry. 15 and up now maps to the highest,
1..14 above normal, and the same below zero.
---
 src/system/xthread.cpp | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/src/system/xthread.cpp b/src/system/xthread.cpp
index 77bce25..989be99 100644
--- a/src/system/xthread.cpp
+++ b/src/system/xthread.cpp
@@ -841,14 +841,19 @@ void XThread::SetPriority(int32_t increment) {
   auto kthread = guest_object<X_KTHREAD>();
   kthread->priority = static_cast<uint8_t>(std::clamp(increment, 0, 31));
 
+  // The increment is a priority boost of -16..16 (15 and 16: the real-time
+  // range a title asks for its audio threads; 1..2 a little above normal).
+  // The old thresholds (over 0x11 / 0x22) left every such request at normal,
+  // so an audio thread got no more CPU than the threads it feeds on a busy
+  // machine.
   int32_t target_priority = 0;
-  if (increment > 0x22) {
+  if (increment >= 15) {
     target_priority = rex::thread::ThreadPriority::kHighest;
-  } else if (increment > 0x11) {
+  } else if (increment > 0) {
     target_priority = rex::thread::ThreadPriority::kAboveNormal;
-  } else if (increment < -0x22) {
+  } else if (increment <= -15) {
     target_priority = rex::thread::ThreadPriority::kLowest;
-  } else if (increment < -0x11) {
+  } else if (increment < 0) {
     target_priority = rex::thread::ThreadPriority::kBelowNormal;
   } else {
     target_priority = rex::thread::ThreadPriority::kNormal;
