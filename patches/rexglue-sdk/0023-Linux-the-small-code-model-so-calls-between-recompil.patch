From eb34aea9bab6a79c5845462719d39c9540ffffeb Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Mon, 16 Nov 2026 17:05:00 +0000
Subject: [PATCH 23/24] Linux: the small code model, so calls between
 recompiled functions are direct

The large model made every call between the game's functions an indirect
one, through a register loaded with the function's full address. Its code
is about 100 MB, well within the small model's 2 GB. (Found by IzunaRecomp,
v0.2.2.1.)
---
 CMakeLists.txt              | 9 +++++----
 cmake/rexglue_helpers.cmake | 6 +++---
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9b3cdf5..7693eb0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -117,10 +117,11 @@ endfunction()
 if(NOT WIN32)
     # Use appropriate code model based on architecture
     if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64" AND NOT APPLE)
-        # Large code model on Linux x86_64 for linking with very large recompiled executables (35MB+).
-        # macOS uses small: the ld64 linker on macOS 15+ rejects text relocations produced
-        # by -mcmodel=large, and macOS maps binaries in the low address space so ±2GB is sufficient.
-        add_compile_options(-mcmodel=large)
+        # Small code model: an executable's code and data within 2 GB of each
+        # other (a recompiled game's code is around 100 MB). The large model
+        # made every call between functions an indirect one through a
+        # register loaded with the full address.
+        add_compile_options(-mcmodel=small)
     else()
         add_compile_options(-mcmodel=small)
     endif()
diff --git a/cmake/rexglue_helpers.cmake b/cmake/rexglue_helpers.cmake
index 41e6dce..1ab7bcf 100644
--- a/cmake/rexglue_helpers.cmake
+++ b/cmake/rexglue_helpers.cmake
@@ -46,10 +46,10 @@ endfunction()
 #==========================================================
 function(rexglue_apply_target_settings target_name)
     if(UNIX AND NOT APPLE)
-        # Large executable support
+        # (the small code model, as the SDK: calls between the recompiled
+        # functions direct)
         if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
-            target_link_options(${target_name} PRIVATE -Wl,--no-relax)
-            target_compile_options(${target_name} PRIVATE -mcmodel=large)
+            target_compile_options(${target_name} PRIVATE -mcmodel=small)
         elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|ARM64")
             target_compile_options(${target_name} PRIVATE -march=armv8-a)
         endif()
