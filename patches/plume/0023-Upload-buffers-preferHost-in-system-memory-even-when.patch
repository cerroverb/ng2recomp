From a9d69b1c2ccf919c54d7e30db3579eb3ad87d3ac Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Tue, 17 Nov 2026 13:47:53 +0000
Subject: [PATCH] Upload buffers: preferHost, in system memory even when the
 GPU reads them directly (VMA puts such a buffer in VRAM through the PCIe BAR,
 where CPU writes are slow on narrow links)

---
 plume_render_interface_types.h | 3 +++
 plume_vulkan.cpp               | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/plume_render_interface_types.h b/plume_render_interface_types.h
index 9024bea..4e05083 100644
--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -913,6 +913,9 @@ namespace plume {
         RenderHeapType heapType = RenderHeapType::UNKNOWN;
         RenderBufferFlags flags = RenderBufferFlag::NONE;
         bool committed = false;
+        // UPLOAD only: in system memory even when the GPU reads it directly (by default such a
+        // buffer may go to VRAM through the PCIe BAR, where CPU writes are slow on narrow links).
+        bool preferHost = false;
 
         RenderBufferDesc() = default;
 
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index aa3d8ce..3023877 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -901,6 +901,9 @@ namespace plume {
         case RenderHeapType::UPLOAD:
             bufferInfo.usage |= VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
             createInfo.flags |= VMA_ALLOCATION_CREATE_HOST_ACCESS_SEQUENTIAL_WRITE_BIT;
+            if (desc.preferHost) {
+                createInfo.usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST;
+            }
             break;
         case RenderHeapType::READBACK:
             bufferInfo.usage |= VK_BUFFER_USAGE_TRANSFER_DST_BIT;
-- 
