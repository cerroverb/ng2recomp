+    bool VulkanSwapChain::hasPresentTiming() const {
+        return timingActive.load();
+    }
+
+    int64_t VulkanSwapChain::getPresentTime(uint64_t presentId) {
+        if (!timingActive.load()) {
+            return 0;
+        }
+        collectTimings();
+        if (!timingMonotonic && !timingCalibrated.load()) {
+            return 0;  // (not comparable with steady_clock's)
+        }
+        const uint32_t slot = uint32_t(presentId % TimingRing);
+        const int64_t time = timingIds[slot].load() == presentId ? timingTimes[slot].load() : 0;
+        return time > 0 ? time + (timingMonotonic ? 0 : timingOffset.load()) : 0;
+    }
