+    // The present timing results come in, oldest first: the last reported
+    // (shown, or never shown: time 0) and the times.
+    void VulkanSwapChain::collectTimings() {
+        const std::scoped_lock lock(vkMutex);
+        if (!timingActive.load() || vk == VK_NULL_HANDLE) {
+            return;
+        }
+        VulkanDevice *device = commandQueue->device;
+        calibrateTimings();
+        constexpr uint32_t Batch = 16;
+        for (int round = 0; round < 8; round++) {
+            VkPresentStageTimeEXT stages[Batch] = {};
+            VkPastPresentationTimingEXT timings[Batch] = {};
+            for (uint32_t i = 0; i < Batch; i++) {
+                timings[i].sType = VK_STRUCTURE_TYPE_PAST_PRESENTATION_TIMING_EXT;
+                timings[i].presentStageCount = 1;
+                timings[i].pPresentStages = &stages[i];
+            }
+            VkPastPresentationTimingPropertiesEXT properties = {};
+            properties.sType = VK_STRUCTURE_TYPE_PAST_PRESENTATION_TIMING_PROPERTIES_EXT;
+            properties.presentationTimingCount = Batch;
+            properties.pPresentationTimings = timings;
+            VkPastPresentationTimingInfoEXT info = {};
+            info.sType = VK_STRUCTURE_TYPE_PAST_PRESENTATION_TIMING_INFO_EXT;
+            info.swapchain = vk;
+            VkResult res = device->getPastPresentationTiming(device->vk, &info, &properties);
+            if (res != VK_SUCCESS && res != VK_INCOMPLETE) {
+                return;
+            }
+            for (uint32_t i = 0; i < properties.presentationTimingCount; i++) {
+                const VkPastPresentationTimingEXT &t = timings[i];
+                if (!t.reportComplete || t.presentId < firstPresentId.load()) {
+                    continue;
+                }
+                int64_t time = 0;
+                for (uint32_t j = 0; j < t.presentStageCount; j++) {
+                    if (t.pPresentStages[j].stage == timingStage) {
+                        time = int64_t(t.pPresentStages[j].time);
+                    }
+                }
+                timingIds[t.presentId % TimingRing] = 0;
+                timingTimes[t.presentId % TimingRing] = time;
+                timingIds[t.presentId % TimingRing] = t.presentId;
+                if (t.presentId > timingShownId.load()) {
+                    timingShownId = t.presentId;
+                }
+            }
+            if (res != VK_INCOMPLETE) {
+                return;
+            }
+        }
+    }
+
+    // The offset from the swapchain's time domain to CLOCK_MONOTONIC, every
+    // second (the clocks drift apart): its present stage's clock and
+    // CLOCK_MONOTONIC read together.
+    void VulkanSwapChain::calibrateTimings() {
+#   if defined(_WIN32)
+        return;  // (CLOCK_MONOTONIC is POSIX: no times on Windows)
+#   endif
+        // (CLOCK_MONOTONIC among the device's calibrateable domains, once)
+        static const bool monotonicCalibrateable = [this] {
+            uint32_t count = 0;
+            if (vkGetPhysicalDeviceCalibrateableTimeDomainsKHR == nullptr ||
+                vkGetPhysicalDeviceCalibrateableTimeDomainsKHR(commandQueue->device->physicalDevice, &count, nullptr) != VK_SUCCESS) {
+                return false;
+            }
+            std::vector<VkTimeDomainKHR> domains(count);
+            vkGetPhysicalDeviceCalibrateableTimeDomainsKHR(commandQueue->device->physicalDevice, &count, domains.data());
+            return std::find(domains.begin(), domains.end(), VK_TIME_DOMAIN_CLOCK_MONOTONIC_KHR) != domains.end();
+        }();
+        if (!monotonicCalibrateable || timingMonotonic || vkGetCalibratedTimestampsKHR == nullptr ||
+            (timingDomainKind != VK_TIME_DOMAIN_PRESENT_STAGE_LOCAL_EXT && timingDomainKind != VK_TIME_DOMAIN_SWAPCHAIN_LOCAL_EXT)) {
+            return;
+        }
+        const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        if (timingCalibratedAt != 0 && now - timingCalibratedAt < 1000000000) {
+            return;
+        }
+        timingCalibratedAt = now;
+        VkSwapchainCalibratedTimestampInfoEXT swapchainInfo = {};
+        swapchainInfo.sType = VK_STRUCTURE_TYPE_SWAPCHAIN_CALIBRATED_TIMESTAMP_INFO_EXT;
+        swapchainInfo.swapchain = vk;
+        swapchainInfo.presentStage = timingDomainKind == VK_TIME_DOMAIN_PRESENT_STAGE_LOCAL_EXT ? timingStage : 0;
+        swapchainInfo.timeDomainId = timingDomainId;
+        VkCalibratedTimestampInfoKHR infos[2] = {};
+        infos[0].sType = VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_KHR;
+        infos[0].pNext = &swapchainInfo;
+        infos[0].timeDomain = timingDomainKind;
+        infos[1].sType = VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_KHR;
+        infos[1].timeDomain = VK_TIME_DOMAIN_CLOCK_MONOTONIC_KHR;
+        uint64_t timestamps[2] = {};
+        uint64_t deviation = 0;
+        VkResult res = vkGetCalibratedTimestampsKHR(commandQueue->device->vk, 2, infos, timestamps, &deviation);
+        if (res != VK_SUCCESS || deviation > 1000000) {
+            if (!timingCalibrated.load()) {
+                static int failures = 0;
+                if (++failures <= 3) {
+                    fprintf(stderr, "plume: present timing: calibration failed (0x%X, deviation %llu ns)\n", res, (unsigned long long)deviation);
+                }
+            }
+            return;
+        }
+        timingOffset = int64_t(timestamps[1]) - int64_t(timestamps[0]);
+        if (!timingCalibrated.exchange(true)) {
+            fprintf(stderr, "plume: present timing: calibrated to CLOCK_MONOTONIC (deviation %llu ns)\n", (unsigned long long)deviation);
+        }
+    }
+
+    void VulkanSwapChain::setPresentTiming(bool on) {
+        timingWanted = on;
+    }
